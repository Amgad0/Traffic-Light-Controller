# ---- Code Composer Studio build output ----
# These folders are fully regenerated by CCS on every build (objects, .out/.map,
# and the auto-generated makefiles). Nothing here is needed to build the project.
Debug/
Release/

# ---- Compiler & linker artifacts (in case a build runs outside Debug/Release) ----
*.o
*.obj
*.d
*.d_raw
*.out
*.map
*.opt
*_linkInfo.xml

# ---- Logs ----
*.log

# ---- Local IDE configuration (not part of the project) ----
.theia/
.clangd
*.theia-workspace
